# ESLintチェック（エラーのみブロック、警告は許容）
CHANGED_JS=$(git diff --cached --name-only -- '*.js' | grep '^js/' | tr '\n' ' ' || true)
if [ -n "$CHANGED_JS" ]; then
  echo "🔍 ESLint: 変更されたJSファイルをチェック中..."
  npx eslint $CHANGED_JS --max-warnings=30
  if [ $? -ne 0 ]; then
    echo "❌ ESLintエラーがあります。修正してからコミットしてください。"
    exit 1
  fi
  echo "✅ ESLint OK"
fi

# 新しいexport追加時のリマインダー（ブロッカーではない）
CHANGED_FILES=$(git diff --cached --name-only)
if echo "$CHANGED_FILES" | grep -q '\.js$'; then
  ADDED_EXPORTS=$(git diff --cached --diff-filter=M -- '*.js' | grep '^+.*export' | grep -v '^+++' || true)
  if [ -n "$ADDED_EXPORTS" ]; then
    echo ""
    echo "⚠️  新しいexportが追加されています。import側の確認を忘れずに:"
    echo "$ADDED_EXPORTS"
    echo ""
  fi
fi
