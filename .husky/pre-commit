# ESLintチェック（エラーのみブロック、警告は許容）
CHANGED_JS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' | grep '^js/' | tr '\n' ' ' || true)
if [ -n "$CHANGED_JS" ]; then
  echo "🔍 ESLint: 変更されたJSファイルをチェック中..."
  npx eslint $CHANGED_JS --max-warnings=30
  if [ $? -ne 0 ]; then
    echo "❌ ESLintエラーがあります。修正してからコミットしてください。"
    exit 1
  fi
  echo "✅ ESLint OK"
fi

# Playwrightスモークテスト（主要操作パスの回帰チェック）
CHANGED_SRC=$(git diff --cached --name-only -- '*.js' '*.html' '*.css' | tr '\n' ' ' || true)
if [ -n "$CHANGED_SRC" ]; then
  echo "🧪 スモークテスト実行中..."
  npx playwright test tests/smoke.spec.js --reporter=dot 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "❌ スモークテストが失敗しました。修正してからコミットしてください。"
    echo "   全テスト実行: npx playwright test --reporter=list"
    exit 1
  fi
  echo "✅ スモークテスト OK"
fi

# 新しいexport追加時のリマインダー（ブロッカーではない）
CHANGED_FILES=$(git diff --cached --name-only)
if echo "$CHANGED_FILES" | grep -q '\.js$'; then
  ADDED_EXPORTS=$(git diff --cached --diff-filter=M -- '*.js' | grep '^+.*export' | grep -v '^+++' || true)
  if [ -n "$ADDED_EXPORTS" ]; then
    echo ""
    echo "⚠️  新しいexportが追加されています。import側の確認を忘れずに:"
    echo "$ADDED_EXPORTS"
    echo ""
  fi
fi
